                          "body_content_type": "application/json",
                          "body_type": "raw",
                          "data": "{\"warehouse_id\": \"a3d231087d62fd96\", \"wait_timeout\": \"30s\", \"disposition\": \"INLINE\", \"format\": \"JSON_ARRAY\", \"statement\": \"SELECT ROUND(SUM(valor_liquido), 2), ROUND(SUM(custo_total), 2), ROUND(SUM(lucro_bruto), 2), ROUND(100 * SUM(lucro_bruto) / SUM(valor_liquido), 2), COUNT(DISTINCT pedido_id), ROUND(SUM(valor_liquido) / COUNT(DISTINCT pedido_id), 2) FROM workspace.dev_adventureworks_gold.fato_financeiro_vendas\"}",
